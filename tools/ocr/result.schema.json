{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:localbrain:ocr:result:v1",
  "title": "Private LocalBrain OCR result; unverified document content",
  "type": "object",
  "required": ["job_id", "input_file_ref", "input_sha256", "profile", "status", "text", "pages", "needs_review", "external_ai", "automatic_knowledge_adoption"],
  "properties": {
    "job_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "input_file_ref": {"type": "string", "pattern": "^ocr:[a-f0-9]{32}/input$"},
    "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "profile": {"enum": ["AUTO", "PRINTED_TEXT", "PDF_DOCUMENT", "TABLE_LAYOUT", "HANDWRITING"]},
    "experimental": {"type": "boolean"},
    "origin": {"const": "local_file"},
    "external_ai": {"const": "deny"},
    "status": {"const": "complete"},
    "text": {"type": "string"},
    "needs_review": {"type": "boolean"},
    "automatic_knowledge_adoption": {"const": false},
    "pages": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/page"}}
  },
  "$defs": {
    "box": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "polygon": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}},
    "span": {
      "type": "object",
      "required": ["page", "span_id", "text", "polygon", "bounding_box", "confidence", "confidence_kind", "needs_review", "unreadable"],
      "properties": {
        "page": {"type": "integer", "minimum": 0},
        "span_id": {"type": "string"},
        "block": {"type": ["integer", "null"]}, "paragraph": {"type": ["integer", "null"]}, "line": {"type": "integer", "minimum": 0},
        "text": {"type": "string", "maxLength": 4096}, "hypothesis": {"type": ["string", "null"]},
        "polygon": {"$ref": "#/$defs/polygon"}, "bounding_box": {"$ref": "#/$defs/box"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence_kind": {"const": "uncalibrated_recognizer_score_not_probability_of_correctness"},
        "needs_review": {"type": "boolean"}, "unreadable": {"type": "boolean"},
        "table_id": {"type": ["string", "null"]}, "row_index": {"type": ["integer", "null"]}, "column_index": {"type": ["integer", "null"]}
      }
    },
    "cell": {
      "type": "object", "required": ["table_id", "row_index", "column_index", "row_span", "column_span", "text", "polygon", "bounding_box"],
      "properties": {"table_id": {"type": "string"}, "row_index": {"type": "integer", "minimum": 0}, "column_index": {"type": "integer", "minimum": 0}, "row_span": {"type": "integer", "minimum": 1}, "column_span": {"type": "integer", "minimum": 1}, "text": {"type": "string"}, "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "cell_id": {"type": "string"}, "needs_review": {"type": "boolean"}, "unreadable": {"type": "boolean"}, "structure_confidence": {"type": ["number", "null"]}, "hypotheses": {"type": "array", "items": {"type": "string"}}, "polygon": {"$ref": "#/$defs/polygon"}, "bounding_box": {"$ref": "#/$defs/box"}}
    },
    "page": {
      "type": "object", "required": ["page", "source_method", "coordinate_system", "spans", "tables", "text", "needs_review", "warnings", "engine", "input_sha256", "status", "external_ai", "network_attempts"],
      "properties": {
        "page": {"type": "integer", "minimum": 0}, "source_method": {"const": "ocr"},
        "status": {"const": "complete"}, "external_ai": {"const": "deny"}, "network_attempts": {"const": 0},
        "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "coordinate_system": {"type": "object", "required": ["units", "origin", "width", "height", "raster_width", "raster_height"], "properties": {"units": {"enum": ["original_image_pixels", "pdf_display_points"]}, "origin": {"const": "top_left"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}, "raster_width": {"type": "integer", "minimum": 1}, "raster_height": {"type": "integer", "minimum": 1}}},
        "spans": {"type": "array", "maxItems": 2500, "items": {"$ref": "#/$defs/span"}},
        "tables": {"type": "array", "maxItems": 32, "items": {"type": "object", "required": ["rows", "columns", "cells", "csv", "markdown", "csv_formula_escaped", "structure_status"], "properties": {"rows": {"type": "integer", "minimum": 1}, "columns": {"type": "integer", "minimum": 1}, "cells": {"type": "array", "items": {"$ref": "#/$defs/cell"}}, "csv": {"type": "string"}, "markdown": {"type": "string"}, "csv_formula_escaped": {"const": true}, "structure_status": {"const": "ruled_grid_detected_verify_before_use"}}}},
        "text": {"type": "string"}, "needs_review": {"type": "boolean"}, "warnings": {"type": "array", "items": {"type": "string"}},
        "engine": {"type": "object", "required": ["engine", "version", "model_hashes", "runtime", "runtime_version", "requested_providers", "threads"], "properties": {"engine": {"const": "RapidOCR"}, "runtime": {"const": "onnxruntime"}, "requested_providers": {"const": ["CPUExecutionProvider"]}, "threads": {"const": 2}}}
      }
    }
  }
}
